# ==============================================================================
# InstaBOT Environment Variables (.env)
# ==============================================================================
# Copy this file to `.env` to override settings in `config.json` or `config/default.json`.

# --- Bot Configuration ---
BOT_NAME=𖤍~𝐈𝐭'𝐬 𝐌𝐄 𝐁𝐀𝐁𝐘 T͜͡𝗘𝗦𝗦𝗔 𝐁𝐎𝐓_𖠌
PREFIX=.
LANGUAGE=en

# --- Bot Administrators (Comma-separated Instagram Numeric User IDs) ---
# Admins have full access to commands even when defaultOff / adminOnly is enabled.
IG_ADMIN_BOT=77925985089

# --- Remote ig-chat-api-server (Mode A) ---
# Leave blank for Mode B (Standalone Native Realtime ICA using account.txt)
IG_API_SERVER=
IG_API_TOKEN=

# --- Session Cookies (Alternative to account.txt) ---
# If set, this overrides account.txt
# IG_COOKIES=sessionid=...; ds_user_id=...; csrftoken=...

# --- Health & Web Server ---
PORT=8080

# --- Custom External API & Music Endpoints ---
INSTABOT_TOKEN=
INSTABOT_URL=
